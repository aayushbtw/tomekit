{
  "name": "tomekit",
  "version": "0.8.0",
  "description": "Fully typed content collections for Markdown.",
  "keywords": [
    "content-collection",
    "markdown",
    "vite-plugin"
  ],
  "homepage": "https://tomekit.aayush.cv",
  "bugs": "https://github.com/aayushbtw/tomekit/issues",
  "license": "MIT",
  "author": "Aayush (https://x.com/aayushbtw)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayushbtw/tomekit.git"
  },
  "bin": {
    "tomekit": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "default": "./dist/content.mjs"
    },
    "./content-modules": {
      "types": "./dist/content-modules.d.mts",
      "default": "./dist/content-modules.mjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "default": "./dist/register.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp check && vp test run && vp pack",
    "test": "vp test run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "js-yaml": "^5.4.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
