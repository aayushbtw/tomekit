{
  "name": "tomekit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp run -r test",
    "release": "GITHUB_TOKEN=$(gh auth token) changeset version && vp fmt"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
